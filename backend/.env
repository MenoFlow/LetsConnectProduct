# URL de connexion à la base PostgreSQL fournie par Docker Compose.
DATABASE_URL="postgresql://materialconnect:materialconnect@localhost:5432/materialconnect?schema=public"
# Origine exacte du frontend local, vérifiée par CORS et la protection CSRF.
FRONTEND_ORIGIN="http://localhost:3000"
# Port d'écoute de l'API.
PORT=4000
# Adresse e-mail du compte administrateur créé par le seed.
ADMIN_EMAIL="admin@materialconnect.local"
# Mot de passe administrateur ; prisma/seed.ts impose un minimum de 12 caractères.
ADMIN_PASSWORD="change-me-please"
# Environnement d'exécution du backend.
NODE_ENV="development"
